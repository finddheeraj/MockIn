# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "grok", "local", or "both"
#   grok  — Use xAI Grok API only
#   local — Use local Llama-3.1-8B GGUF model only
#   both  — Call both in parallel and display both responses
LLM_PROVIDER=grok

# ── Grok API (xAI) ──────────────────────────────────────────────────────────
XAI_API_KEY=

# ── Local Llama Model ────────────────────────────────────────────────────────
LOCAL_MODEL_PATH=C:\Users\dheeraj\Desktop\AIApp\LLMModels\llama-3-8b-gguf\Llama-3.1-8B.gguf
LOCAL_MODEL_CONTEXT_SIZE=4096
LOCAL_MODEL_GPU_LAYERS=0
